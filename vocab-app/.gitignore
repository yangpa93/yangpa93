# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android

# eas init 이 적어 둔 연결 정보를 pull 전에 보관하는 파일
app.json.bak

# npm run audit 이 쓰는 영어 낱말 사전 (4MB). 필요할 때 받아서 쓰는 것이라
# 저장소에 넣지 않는다.
#   curl -sLO https://raw.githubusercontent.com/dwyl/english-words/master/words_alpha.txt
words_alpha.txt

# 파이어베이스 서비스 계정 키 — 이건 비밀번호에 해당한다.
# 이 파일 하나면 누구나 우리 아이들 폰으로 알림을 보낼 수 있고,
# 파이어베이스 프로젝트를 통째로 만질 수 있다. 저장소에 올리지 않는다.
# (EAS 에 한 번 올려 두면 빌드할 때는 이 파일이 필요 없다.)
*-firebase-adminsdk-*.json
service-account*.json

# google-services.json 은 일부러 올린다.
# 비밀이 아니고(APK 안에 그대로 들어간다) app.json 이 이 파일을 가리키므로,
# 빠지면 새로 clone 한 곳에서 빌드가 실패한다.

# 사전 오픈 API 인증키. 저장소에 올라가면 누구든 쓸 수 있게 된다.
# 키는 STDICT_KEY 환경 변수로만 넘긴다.
.env
.env.local
*stdict-key*

# 연결 미리 보기가 만드는 QR 그림. 올릴 것이 아니다.
link-check/

# 미리보기를 창 뒤로 돌려 띄울 때 나오는 기록. 그때그때 버린다.
preview.log

# 파이어베이스 **서비스 계정 열쇠**. 이것만은 절대 올라가면 안 된다.
#
# google-services.json 과 헷갈리기 쉬운데 성격이 완전히 다르다. 그쪽은 앱 안에
# 들어가 폰마다 깔리는 것이라 비밀이 아니고, 이쪽은 **우리 대신 알림을 보낼 수
# 있는 열쇠**다. 올라가면 누구든 우리 이름으로 알림을 보낼 수 있다.
#
# 받은 파일은 EAS 에 올린 뒤(npx eas-cli credentials) 지우면 된다. EAS 가
# 들고 있으므로 컴퓨터에 남겨 둘 이유가 없다.
*firebase-adminsdk*.json
*service-account*.json
*serviceAccount*.json
